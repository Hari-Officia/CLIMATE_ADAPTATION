{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StrategyViewSchema",
  "type": "object",
  "required": ["strategy_id", "name", "status_display", "review_status"],
  "properties": {
    "strategy_id": { "type": "string" },
    "name": { "type": "string" },
    "domain": { "type": "string" },
    "status_display": { "type": "string", "enum": ["ELIGIBLE", "CONDITIONAL", "REVIEW_REQUIRED", "EXCLUDED", "INSUFFICIENT_DATA"] },
    "review_status": { "type": "string" }
  }
}
