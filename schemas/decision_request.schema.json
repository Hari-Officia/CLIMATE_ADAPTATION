{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionRequestSchema",
  "type": "object",
  "required": [
    "district_id"
  ],
  "properties": {
    "district_id": { "type": "string" },
    "hazard_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "optimization_mode": { "type": "string", "default": "CLASSICAL" },
    "qaoa_p_depth": { "type": "integer", "default": 2 },
    "explanation_mode": { "type": "string", "default": "STRICT_GROUNDED" },
    "detail_level": { "type": "string", "default": "FULL" },
    "idempotency_key": { "type": ["string", "null"] }
  }
}
