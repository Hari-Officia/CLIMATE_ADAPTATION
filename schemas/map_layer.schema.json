{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapLayerSchema",
  "type": "object",
  "required": ["layer_id", "layer_name", "layer_type", "visible", "opacity"],
  "properties": {
    "layer_id": { "type": "string" },
    "layer_name": { "type": "string" },
    "layer_type": { "type": "string", "enum": ["BASE", "DISTRICT", "HAZARD", "EXPOSURE", "DECISION"] },
    "visible": { "type": "boolean" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
