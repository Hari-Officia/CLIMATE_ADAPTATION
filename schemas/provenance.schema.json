{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProvenanceSchema",
  "type": "object",
  "required": [
    "decision_id",
    "request_id",
    "workflow_id",
    "context_hash",
    "evidence_packet_hash",
    "system_versions"
  ],
  "properties": {
    "decision_id": { "type": "string" },
    "request_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "context_hash": { "type": "string" },
    "evidence_packet_hash": { "type": "string" },
    "system_versions": { "type": "object" },
    "snapshots": {
      "type": "object",
      "properties": {
        "risk_snapshot_id": { "type": "string" },
        "priority_snapshot_id": { "type": "string" },
        "optimization_run_id": { "type": "string" },
        "qubo_id": { "type": "string" },
        "qaoa_experiment_id": { "type": "string" },
        "explanation_id": { "type": "string" }
      }
    },
    "created_at": { "type": "string" }
  }
}
