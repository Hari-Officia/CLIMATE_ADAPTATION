{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BatchDecisionSchema",
  "type": "object",
  "required": [
    "batch_id",
    "total_districts",
    "completed_districts",
    "failed_districts",
    "status",
    "results"
  ],
  "properties": {
    "batch_id": { "type": "string" },
    "total_districts": { "type": "integer" },
    "completed_districts": { "type": "integer" },
    "failed_districts": { "type": "integer" },
    "status": { "type": "string" },
    "results": {
      "type": "array",
      "items": { "type": "object" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
