# PRODUCTION / ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and set secure values for deployment.

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_32_CHAR_RANDOM_SECRET_KEY

# PostgreSQL + PostGIS Infrastructure
DATABASE_URL=postgresql+psycopg://climate_user:SECURE_PASSWORD@db:5432/climate_platform
PREFER_POSTGRES=true

# Vector Store / RAG Storage
CHROMA_PERSIST_DIR=knowledge_base/chroma

# Auth & Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_CORS_ORIGINS=https://climate.tn.gov.in

# Feature Flags
ENABLE_QAOA=true
ENABLE_LLM_EXPLANATIONS=true
ENABLE_RAG_EVIDENCE=true

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=JSON
